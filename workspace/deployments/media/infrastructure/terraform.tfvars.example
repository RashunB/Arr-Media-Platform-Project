# Copy to terraform.tfvars (gitignored) and replace every placeholder.
proxmox_endpoint  = "https://pve.example.internal:8006/"
proxmox_api_token = "terraform@pve!terraform=00000000-0000-0000-0000-000000000000" # sensitive
proxmox_user      = "root@pam"
proxmox_password  = "change-me" # sensitive
proxmox_node_name = "pve"

datastore_infra = "vmdata"
datastore_files = "vmfiles"

vm_name_prefix  = "media"
vm_group        = "media_platform"
vm_default_user = "ansible"
vm_tag_list     = ["media_platform"]

cloudflare_zone_id     = "00000000000000000000000000000000"
cloudflare_record_name = "media.example.com"

# Optional overrides (defaults shown in README.md "Inputs"):
# vm_count    = 1
# cpu         = 2
# memory      = 2048
# dns_servers = ["192.0.2.1", "1.1.1.1"]
